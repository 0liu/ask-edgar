# Copy to .env (never committed). `make` exports these to every target, and
# docker compose reads POSTGRES_PORT for the host port mapping.
DATABASE_URL=postgresql://edgar:edgar@localhost:5432/edgar
ANTHROPIC_API_KEY=
# Agent model id; leave empty for the default in src/ask_edgar/agent.py.
ASK_EDGAR_MODEL=
# Host port of the Postgres container. Change it if 5432 is taken on your machine,
# and change the port in DATABASE_URL to match.
POSTGRES_PORT=5432
